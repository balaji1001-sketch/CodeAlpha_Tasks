# ==========================================================
# SERVER
# ==========================================================
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed origins for CORS.
# Add the origin you serve the frontend from.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# Public base URL of this API (used to build absolute image URLs)
SERVER_URL=http://localhost:5000

# ==========================================================
# DATABASE
# ==========================================================
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/socialmedia
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/socialmedia?retryWrites=true&w=majority

# ==========================================================
# AUTH
# ==========================================================
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_value
JWT_EXPIRES_IN=7d

# ==========================================================
# UPLOADS
# ==========================================================
MAX_FILE_SIZE_MB=5

# ==========================================================
# RATE LIMITING
# ==========================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
